<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Student Matching" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Student Matching">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
      <div class="container-fluid">
        <%= link_to "Student Matching", root_path, class: "navbar-brand" %>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav me-auto">
            <% if user_signed_in? %>
              <li class="nav-item">
                <%= link_to "検索", search_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "プロジェクト一覧", projects_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "スカウト", scouts_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "応募", applications_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "マッチング", matches_path, class: "nav-link" %>
              </li>
            <% end %>
          </ul>
          <ul class="navbar-nav ms-auto">
            <% if user_signed_in? %>
              <li class="nav-item">
                <span class="navbar-text text-white me-3">
                  現在: <strong><%= project_owner_mode? ? "プロジェクトオーナー" : "スキルホルダー" %></strong>モード
                </span>
              </li>
              <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                  <%= current_user.name %>
                </a>
                <ul class="dropdown-menu dropdown-menu-end">
                  <li>
                    <%= button_to "プロジェクトオーナーモード", switch_mode_path(mode: "project_owner"), method: :post, class: "dropdown-item #{'active' if project_owner_mode?}", form: { style: "display: inline;" } %>
                  </li>
                  <li>
                    <%= button_to "スキルホルダーモード", switch_mode_path(mode: "skill_holder"), method: :post, class: "dropdown-item #{'active' if skill_holder_mode?}", form: { style: "display: inline;" } %>
                  </li>
                  <li><hr class="dropdown-divider"></li>
                  <li>
                    <%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "dropdown-item", form: { style: "display: inline;" } %>
                  </li>
                </ul>
              </li>
            <% else %>
              <li class="nav-item">
                <%= link_to "ログイン", new_user_session_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "新規登録", new_user_registration_path, class: "nav-link" %>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </nav>

    <div class="container mt-4">
      <% if notice %>
        <div class="alert alert-info alert-dismissible fade show" role="alert">
          <%= notice %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>
      <% if alert %>
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
          <%= alert %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>

      <%= yield %>
    </div>

    <!-- マッチング成立モーダル -->
    <% if match_sns_data.present? && match_sns_data[:partner].present? && match_sns_data[:project].present? %>
      <div class="modal fade" id="matchSnsModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-lg">
          <div class="modal-content">
            <div class="modal-header bg-success">
              <h5 class="modal-title">
                <i class="bi bi-check-circle-fill me-2"></i>
                マッチング成立！
              </h5>
              <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <div class="text-center mb-4">
                <h4 class="mb-3">おめでとうございます！</h4>
                <p class="text-muted">
                  <strong><%= match_sns_data[:partner].name %></strong>さんとのマッチングが成立しました。<br>
                  プロジェクト「<strong><%= match_sns_data[:project].title %></strong>」で一緒に活動しましょう！
                </p>
              </div>

              <!-- Partner Profile -->
              <div class="card mb-3">
                <div class="card-header bg-info text-white">
                  <h6 class="mb-0">
                    <i class="bi bi-person-circle me-2"></i>
                    <%= match_sns_data[:partner].name %>さんのプロフィール
                  </h6>
                </div>
                <div class="card-body">
                  <% if project_owner_mode? %>
                    <!-- スキルホルダーのプロフィール表示（プロジェクトオーナーが見る場合） -->
                    <% if match_sns_data[:partner].skill_holder_profile.present? %>
                      <% profile = match_sns_data[:partner].skill_holder_profile %>
                      <% if profile.introduction.present? %>
                        <div class="mb-3">
                          <strong class="d-block mb-1">自己紹介:</strong>
                          <p class="mb-0"><%= simple_format(profile.introduction) %></p>
                        </div>
                      <% end %>
                      <% if match_sns_data[:partner].skills.any? %>
                        <div class="mb-3">
                          <strong class="d-block mb-1">スキル:</strong>
                          <% match_sns_data[:partner].skills.limit(15).each do |skill| %>
                            <span class="badge bg-secondary me-1 mb-1"><%= skill.name %></span>
                          <% end %>
                        </div>
                      <% end %>
                      <% if profile.past_work.present? %>
                        <div class="mb-3">
                          <strong class="d-block mb-1">過去の実績:</strong>
                          <p class="mb-0 text-muted small"><%= truncate(profile.past_work, length: 200) %></p>
                        </div>
                      <% end %>
                    <% else %>
                      <p class="text-muted mb-0">プロフィールが未設定です。</p>
                    <% end %>
                  <% else %>
                    <!-- プロジェクトオーナーのプロフィール表示（スキルホルダーが見る場合） -->
                    <% if match_sns_data[:partner].project_owner_profile.present? %>
                      <% profile = match_sns_data[:partner].project_owner_profile %>
                      <% if profile.introduction.present? %>
                        <div class="mb-3">
                          <strong class="d-block mb-1">自己紹介:</strong>
                          <p class="mb-0"><%= simple_format(profile.introduction) %></p>
                        </div>
                      <% end %>
                      <% if profile.goals.present? %>
                        <div class="mb-3">
                          <strong class="d-block mb-1">目標:</strong>
                          <p class="mb-0"><%= simple_format(profile.goals) %></p>
                        </div>
                      <% end %>
                      <% if profile.past_projects.present? %>
                        <div class="mb-3">
                          <strong class="d-block mb-1">過去のプロジェクト:</strong>
                          <p class="mb-0 text-muted small"><%= truncate(profile.past_projects, length: 200) %></p>
                        </div>
                      <% end %>
                    <% else %>
                      <p class="text-muted mb-0">プロフィールが未設定です。</p>
                    <% end %>
                  <% end %>
                </div>
              </div>

              <!-- Partner SNS Links -->
              <div class="card">
                <div class="card-header bg-primary">
                  <h6 class="mb-0">
                    <i class="bi bi-share me-2"></i>
                    <%= match_sns_data[:partner].name %>さんの連絡先
                  </h6>
                </div>
                <div class="card-body">
                  <% partner_sns_links = match_sns_data[:partner].sns_links.where(visible_after_match: true) %>
                  <% if partner_sns_links.any? %>
                    <div class="list-group">
                      <% partner_sns_links.each do |sns_link| %>
                        <a href="<%= sns_link.url %>" target="_blank" class="list-group-item list-group-item-action d-flex align-items-center">
                          <% case sns_link.platform %>
                          <% when 'Twitter' %>
                            <i class="bi bi-twitter me-3 fs-4 text-primary"></i>
                          <% when 'Instagram' %>
                            <i class="bi bi-instagram me-3 fs-4" style="color: #E4405F;"></i>
                          <% when 'Facebook' %>
                            <i class="bi bi-facebook me-3 fs-4 text-primary"></i>
                          <% when 'Discord' %>
                            <i class="bi bi-discord me-3 fs-4" style="color: #5865F2;"></i>
                          <% when 'Slack' %>
                            <i class="bi bi-slack me-3 fs-4" style="color: #4A154B;"></i>
                          <% when 'LINE' %>
                            <i class="bi bi-line me-3 fs-4" style="color: #00B900;"></i>
                          <% when 'Email' %>
                            <i class="bi bi-envelope me-3 fs-4 text-secondary"></i>
                          <% else %>
                            <i class="bi bi-link-45deg me-3 fs-4 text-secondary"></i>
                          <% end %>
                          <div>
                            <strong><%= sns_link.platform %></strong>
                            <br>
                            <small class="text-muted"><%= sns_link.url %></small>
                          </div>
                          <i class="bi bi-box-arrow-up-right ms-auto"></i>
                        </a>
                      <% end %>
                    </div>
                  <% else %>
                    <div class="alert alert-info mb-0">
                      <i class="bi bi-info-circle me-2"></i>
                      まだ連絡先が登録されていません。マッチング一覧から後で確認できます。
                    </div>
                  <% end %>
                </div>
              </div>

              <div class="alert alert-warning mt-3 mb-0">
                <i class="bi bi-exclamation-triangle me-2"></i>
                <strong>次のステップ:</strong> 上記の連絡先からメッセージを送って、プロジェクトの詳細を話し合いましょう！
              </div>
            </div>
            <div class="modal-footer">
              <%= link_to 'マッチング一覧を見る', matches_path, class: 'btn btn-primary' %>
              <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">閉じる</button>
            </div>
          </div>
        </div>
      </div>

      <script>
        document.addEventListener('DOMContentLoaded', function() {
          var matchModal = new bootstrap.Modal(document.getElementById('matchSnsModal'));
          matchModal.show();
        });
      </script>
    <% end %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
