<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Student Matching" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Student Matching">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
      <div class="container-fluid">
        <%= link_to "Student Matching", root_path, class: "navbar-brand" %>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav me-auto">
            <% if user_signed_in? %>
              <li class="nav-item">
                <%= link_to "検索", search_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "プロジェクト一覧", projects_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "スカウト", scouts_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "応募", applications_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "マッチング", matches_path, class: "nav-link" %>
              </li>
            <% end %>
          </ul>
          <ul class="navbar-nav ms-auto">
            <% if user_signed_in? %>
              <li class="nav-item">
                <span class="navbar-text text-white me-3">
                  現在: <strong><%= project_owner_mode? ? "プロジェクトオーナー" : "スキルホルダー" %></strong>モード
                </span>
              </li>
              <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                  <%= current_user.name %>
                </a>
                <ul class="dropdown-menu dropdown-menu-end">
                  <li>
                    <%= button_to "プロジェクトオーナーモード", switch_mode_path(mode: "project_owner"), method: :post, class: "dropdown-item #{'active' if project_owner_mode?}", form: { style: "display: inline;" } %>
                  </li>
                  <li>
                    <%= button_to "スキルホルダーモード", switch_mode_path(mode: "skill_holder"), method: :post, class: "dropdown-item #{'active' if skill_holder_mode?}", form: { style: "display: inline;" } %>
                  </li>
                  <li><hr class="dropdown-divider"></li>
                  <li>
                    <%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "dropdown-item", form: { style: "display: inline;" } %>
                  </li>
                </ul>
              </li>
            <% else %>
              <li class="nav-item">
                <%= link_to "ログイン", new_user_session_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "新規登録", new_user_registration_path, class: "nav-link" %>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </nav>

    <div class="container mt-4">
      <% if notice %>
        <div class="alert alert-info alert-dismissible fade show" role="alert">
          <%= notice %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>
      <% if alert %>
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
          <%= alert %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>

      <%= yield %>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
