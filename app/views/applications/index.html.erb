<div class="container mt-4">
  <h1 class="mb-4">応募管理</h1>

  <!-- Nav tabs for my/received applications -->
  <ul class="nav nav-tabs mb-4" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="nav-link active" id="my-tab" data-bs-toggle="tab" data-bs-target="#my" type="button" role="tab">
        自分の応募
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="received-tab" data-bs-toggle="tab" data-bs-target="#received" type="button" role="tab">
        受信した応募
        <% if @received_applications.pending.any? %>
          <span class="badge bg-danger"><%= @received_applications.pending.count %></span>
        <% end %>
      </button>
    </li>
  </ul>

  <!-- Tab content -->
  <div class="tab-content">
    <!-- My Applications Tab -->
    <div class="tab-pane fade show active" id="my" role="tabpanel">
      <% if @my_applications.any? %>
        <% @my_applications.each do |application| %>
          <div class="card mb-3">
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-start">
                <div>
                  <h5 class="card-title">
                    <%= link_to application.project.title, project_path(application.project) %>
                  </h5>
                  <p class="card-text text-muted">
                    <small>
                      <%= application.created_at.strftime('%Y/%m/%d %H:%M') %>に応募
                    </small>
                  </p>
                  <% if application.message.present? %>
                    <p class="card-text"><%= application.message %></p>
                  <% end %>
                </div>
                <div>
                  <% if application.status == 'pending' %>
                    <span class="badge bg-warning text-dark">審査中</span>
                  <% elsif application.status == 'accepted' %>
                    <span class="badge bg-success">承認済み</span>
                  <% elsif application.status == 'rejected' %>
                    <span class="badge bg-secondary">却下された</span>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="alert alert-info">
          まだプロジェクトに応募していません
        </div>
      <% end %>
    </div>

    <!-- Received Applications Tab -->
    <div class="tab-pane fade" id="received" role="tabpanel">
      <% if @received_applications.any? %>
        <% @received_applications.each do |application| %>
          <div class="card mb-3">
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-start">
                <div>
                  <h5 class="card-title">
                    <%= link_to application.project.title, project_path(application.project) %>
                  </h5>
                  <p class="card-text text-muted">
                    <small>
                      <%= application.applicant.name %>さんから
                      <span class="mx-1">•</span>
                      <%= application.created_at.strftime('%Y/%m/%d %H:%M') %>
                    </small>
                  </p>
                  <% if application.message.present? %>
                    <p class="card-text"><%= application.message %></p>
                  <% end %>
                </div>
                <div>
                  <% if application.status == 'pending' %>
                    <span class="badge bg-warning text-dark">未承認</span>
                  <% elsif application.status == 'accepted' %>
                    <span class="badge bg-success">承認済み</span>
                  <% elsif application.status == 'rejected' %>
                    <span class="badge bg-secondary">却下済み</span>
                  <% end %>
                </div>
              </div>

              <% if application.status == 'pending' %>
                <div class="mt-3">
                  <%= button_to '承認する', accept_application_path(application), method: :post, class: 'btn btn-success me-2' %>
                  <%= button_to '却下する', reject_application_path(application), method: :post, class: 'btn btn-outline-secondary', data: { confirm: '本当に却下しますか?' } %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="alert alert-info">
          受信した応募はありません
        </div>
      <% end %>
    </div>
  </div>
</div>
