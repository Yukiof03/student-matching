<div class="container mt-4">
  <h1 class="mb-4">応募管理</h1>

  <!-- Nav tabs for my/received applications -->
  <ul class="nav nav-tabs mb-4" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="nav-link active" id="my-tab" data-bs-toggle="tab" data-bs-target="#my" type="button" role="tab">
        自分の応募
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="received-tab" data-bs-toggle="tab" data-bs-target="#received" type="button" role="tab">
        受信した応募
        <% if @received_applications.pending.any? %>
          <span class="badge bg-danger"><%= @received_applications.pending.count %></span>
        <% end %>
      </button>
    </li>
  </ul>

  <!-- Tab content -->
  <div class="tab-content">
    <!-- My Applications Tab -->
    <div class="tab-pane fade show active" id="my" role="tabpanel">
      <% if @my_applications.any? %>
        <% @my_applications.each do |application| %>
          <div class="card mb-3">
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-start">
                <div>
                  <h5 class="card-title">
                    <%= link_to application.project.title, project_path(application.project) %>
                  </h5>
                  <p class="card-text text-muted">
                    <small>
                      <%= application.created_at.strftime('%Y/%m/%d %H:%M') %>に応募
                    </small>
                  </p>
                  <% if application.message.present? %>
                    <p class="card-text"><%= application.message %></p>
                  <% end %>
                </div>
                <div>
                  <% if application.status == 'pending' %>
                    <span class="badge bg-warning text-dark">審査中</span>
                  <% elsif application.status == 'accepted' %>
                    <span class="badge bg-success">承認済み</span>
                  <% elsif application.status == 'rejected' %>
                    <span class="badge bg-secondary">却下された</span>
                  <% end %>
                </div>
              </div>

              <%# マッチングが成立している場合、プロジェクトオーナーのSNS情報を表示 %>
              <% if application.status == 'accepted' && Match.exists?(project: application.project, matched_user_id: current_user.id) %>
                <div class="alert alert-success mt-3 mb-0">
                  <h6 class="alert-heading">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    マッチング成立！プロジェクトオーナーの連絡先
                  </h6>
                  <% owner_sns_links = application.project.owner.sns_links.where(visible_after_match: true) %>
                  <% if owner_sns_links.any? %>
                    <div class="list-group list-group-flush">
                      <% owner_sns_links.each do |sns_link| %>
                        <a href="<%= sns_link.url %>" target="_blank" class="list-group-item list-group-item-action d-flex align-items-center py-2">
                          <% case sns_link.platform %>
                          <% when 'Twitter' %>
                            <i class="bi bi-twitter me-2 text-primary"></i>
                          <% when 'Instagram' %>
                            <i class="bi bi-instagram me-2" style="color: #E4405F;"></i>
                          <% when 'Facebook' %>
                            <i class="bi bi-facebook me-2 text-primary"></i>
                          <% when 'Discord' %>
                            <i class="bi bi-discord me-2" style="color: #5865F2;"></i>
                          <% when 'Slack' %>
                            <i class="bi bi-slack me-2" style="color: #4A154B;"></i>
                          <% when 'LINE' %>
                            <i class="bi bi-line me-2" style="color: #00B900;"></i>
                          <% when 'Email' %>
                            <i class="bi bi-envelope me-2"></i>
                          <% else %>
                            <i class="bi bi-link-45deg me-2"></i>
                          <% end %>
                          <span><strong><%= sns_link.platform %>:</strong> <%= sns_link.url %></span>
                          <i class="bi bi-box-arrow-up-right ms-auto"></i>
                        </a>
                      <% end %>
                    </div>
                  <% else %>
                    <p class="mb-0 small">プロジェクトオーナーの連絡先が登録されていません。</p>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="alert alert-info">
          まだプロジェクトに応募していません
        </div>
      <% end %>
    </div>

    <!-- Received Applications Tab -->
    <div class="tab-pane fade" id="received" role="tabpanel">
      <% if @received_applications.any? %>
        <% @received_applications.each do |application| %>
          <div class="card mb-3">
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-start">
                <div>
                  <h5 class="card-title">
                    <%= link_to application.project.title, project_path(application.project) %>
                  </h5>
                  <p class="card-text text-muted">
                    <small>
                      <%= application.applicant.name %>さんから
                      <span class="mx-1">•</span>
                      <%= application.created_at.strftime('%Y/%m/%d %H:%M') %>
                    </small>
                  </p>
                  <% if application.message.present? %>
                    <p class="card-text"><%= application.message %></p>
                  <% end %>
                </div>
                <div>
                  <% if application.status == 'pending' %>
                    <span class="badge bg-warning text-dark">未承認</span>
                  <% elsif application.status == 'accepted' %>
                    <span class="badge bg-success">承認済み</span>
                  <% elsif application.status == 'rejected' %>
                    <span class="badge bg-secondary">却下済み</span>
                  <% end %>
                </div>
              </div>

              <%# マッチングが成立している場合、応募者のSNS情報を表示 %>
              <% if application.status == 'accepted' && Match.exists?(project: application.project, matched_user_id: application.applicant_id) %>
                <div class="alert alert-success mt-3">
                  <h6 class="alert-heading">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    マッチング成立！応募者の連絡先
                  </h6>
                  <% applicant_sns_links = application.applicant.sns_links.where(visible_after_match: true) %>
                  <% if applicant_sns_links.any? %>
                    <div class="list-group list-group-flush">
                      <% applicant_sns_links.each do |sns_link| %>
                        <a href="<%= sns_link.url %>" target="_blank" class="list-group-item list-group-item-action d-flex align-items-center py-2">
                          <% case sns_link.platform %>
                          <% when 'Twitter' %>
                            <i class="bi bi-twitter me-2 text-primary"></i>
                          <% when 'Instagram' %>
                            <i class="bi bi-instagram me-2" style="color: #E4405F;"></i>
                          <% when 'Facebook' %>
                            <i class="bi bi-facebook me-2 text-primary"></i>
                          <% when 'Discord' %>
                            <i class="bi bi-discord me-2" style="color: #5865F2;"></i>
                          <% when 'Slack' %>
                            <i class="bi bi-slack me-2" style="color: #4A154B;"></i>
                          <% when 'LINE' %>
                            <i class="bi bi-line me-2" style="color: #00B900;"></i>
                          <% when 'Email' %>
                            <i class="bi bi-envelope me-2"></i>
                          <% else %>
                            <i class="bi bi-link-45deg me-2"></i>
                          <% end %>
                          <span><strong><%= sns_link.platform %>:</strong> <%= sns_link.url %></span>
                          <i class="bi bi-box-arrow-up-right ms-auto"></i>
                        </a>
                      <% end %>
                    </div>
                  <% else %>
                    <p class="mb-0 small">応募者の連絡先が登録されていません。</p>
                  <% end %>
                </div>
              <% end %>

              <% if application.status == 'pending' %>
                <div class="mt-3">
                  <%= button_to '承認する', accept_application_path(application), method: :post, class: 'btn btn-success me-2' %>
                  <%= button_to '却下する', reject_application_path(application), method: :post, class: 'btn btn-outline-secondary', data: { confirm: '本当に却下しますか?' } %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="alert alert-info">
          受信した応募はありません
        </div>
      <% end %>
    </div>
  </div>
</div>
