<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <h1 class="mb-4">スキルホルダープロフィール編集</h1>

      <%= form_with model: @profile, url: profiles_skill_holder_profile_path, method: :patch, local: true do |f| %>
        <div class="card">
          <div class="card-body">
            <div class="mb-3">
              <%= f.label :introduction, '自己紹介', class: 'form-label' %>
              <%= f.text_area :introduction, rows: 5, class: 'form-control', placeholder: 'あなたの紹介やスキルへの熱意を入力してください' %>
            </div>

            <div class="mb-3">
              <%= f.label :past_work, '過去の作品・実績', class: 'form-label' %>
              <%= f.text_area :past_work, rows: 4, class: 'form-control', placeholder: 'これまでに作成した作品や参加したプロジェクトを入力してください' %>
            </div>

            <div class="mb-3">
              <%= f.label :achievements, '受賞歴・資格', class: 'form-label' %>
              <%= f.text_area :achievements, rows: 3, class: 'form-control', placeholder: '受賞歴や取得した資格を入力してください' %>
            </div>

            <div class="mb-3">
              <%= f.label :availability, '活動可能時間', class: 'form-label' %>
              <%= f.text_field :availability, class: 'form-control', placeholder: '例: 平日夕方、週末終日' %>
            </div>

            <div class="d-flex gap-2">
              <%= f.submit '保存', class: 'btn btn-primary' %>
              <%= link_to 'キャンセル', root_path, class: 'btn btn-outline-secondary' %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
