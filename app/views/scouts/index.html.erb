<div class="container mt-4">
  <h1 class="mb-4">スカウト管理</h1>

  <!-- Nav tabs for received/sent scouts -->
  <ul class="nav nav-tabs mb-4" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="nav-link active" id="received-tab" data-bs-toggle="tab" data-bs-target="#received" type="button" role="tab">
        受信したスカウト
        <% if @received_scouts.pending.any? %>
          <span class="badge bg-danger"><%= @received_scouts.pending.count %></span>
        <% end %>
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="sent-tab" data-bs-toggle="tab" data-bs-target="#sent" type="button" role="tab">
        送信したスカウト
      </button>
    </li>
  </ul>

  <!-- Tab content -->
  <div class="tab-content">
    <!-- Received Scouts Tab -->
    <div class="tab-pane fade show active" id="received" role="tabpanel">
      <% if @received_scouts.any? %>
        <% @received_scouts.each do |scout| %>
          <div class="card mb-3">
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-start">
                <div>
                  <h5 class="card-title">
                    <%= link_to scout.project.title, project_path(scout.project) %>
                  </h5>
                  <p class="card-text text-muted">
                    <small>
                      <%= scout.scout_user.name %>さんから
                      <span class="mx-1">•</span>
                      <%= scout.created_at.strftime('%Y/%m/%d %H:%M') %>
                    </small>
                  </p>
                  <% if scout.message.present? %>
                    <p class="card-text"><%= scout.message %></p>
                  <% end %>
                </div>
                <div>
                  <% if scout.status == 'pending' %>
                    <span class="badge bg-warning text-dark">未承認</span>
                  <% elsif scout.status == 'accepted' %>
                    <span class="badge bg-success">承認済み</span>
                  <% elsif scout.status == 'rejected' %>
                    <span class="badge bg-secondary">辞退済み</span>
                  <% end %>
                </div>
              </div>

              <%# マッチングが成立している場合、プロジェクトオーナーのSNS情報を表示 %>
              <% if scout.status == 'accepted' && Match.exists?(project: scout.project, matched_user_id: current_user.id) %>
                <div class="alert alert-success mt-3">
                  <h6 class="alert-heading">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    マッチング成立！プロジェクトオーナーの連絡先
                  </h6>
                  <% owner_sns_links = scout.project.owner.sns_links.where(visible_after_match: true) %>
                  <% if owner_sns_links.any? %>
                    <div class="list-group list-group-flush">
                      <% owner_sns_links.each do |sns_link| %>
                        <a href="<%= sns_link.url %>" target="_blank" class="list-group-item list-group-item-action d-flex align-items-center py-2">
                          <% case sns_link.platform %>
                          <% when 'Twitter' %>
                            <i class="bi bi-twitter me-2 text-primary"></i>
                          <% when 'Instagram' %>
                            <i class="bi bi-instagram me-2" style="color: #E4405F;"></i>
                          <% when 'Facebook' %>
                            <i class="bi bi-facebook me-2 text-primary"></i>
                          <% when 'Discord' %>
                            <i class="bi bi-discord me-2" style="color: #5865F2;"></i>
                          <% when 'Slack' %>
                            <i class="bi bi-slack me-2" style="color: #4A154B;"></i>
                          <% when 'LINE' %>
                            <i class="bi bi-line me-2" style="color: #00B900;"></i>
                          <% when 'Email' %>
                            <i class="bi bi-envelope me-2"></i>
                          <% else %>
                            <i class="bi bi-link-45deg me-2"></i>
                          <% end %>
                          <span><strong><%= sns_link.platform %>:</strong> <%= sns_link.url %></span>
                          <i class="bi bi-box-arrow-up-right ms-auto"></i>
                        </a>
                      <% end %>
                    </div>
                  <% else %>
                    <p class="mb-0 small">プロジェクトオーナーの連絡先が登録されていません。</p>
                  <% end %>
                </div>
              <% end %>

              <% if scout.status == 'pending' %>
                <div class="mt-3">
                  <%= button_to '承認する', accept_scout_path(scout), method: :post, class: 'btn btn-success me-2' %>
                  <%= button_to '辞退する', reject_scout_path(scout), method: :post, class: 'btn btn-outline-secondary', data: { confirm: '本当に辞退しますか?' } %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="alert alert-info">
          受信したスカウトはありません
        </div>
      <% end %>
    </div>

    <!-- Sent Scouts Tab -->
    <div class="tab-pane fade" id="sent" role="tabpanel">
      <% if @sent_scouts.any? %>
        <% @sent_scouts.each do |scout| %>
          <div class="card mb-3">
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-start">
                <div>
                  <h5 class="card-title">
                    <%= link_to scout.project.title, project_path(scout.project) %>
                  </h5>
                  <p class="card-text text-muted">
                    <small>
                      <%= scout.scouted_user.name %>さんへ
                      <span class="mx-1">•</span>
                      <%= scout.created_at.strftime('%Y/%m/%d %H:%M') %>
                    </small>
                  </p>
                  <% if scout.message.present? %>
                    <p class="card-text"><%= scout.message %></p>
                  <% end %>
                </div>
                <div>
                  <% if scout.status == 'pending' %>
                    <span class="badge bg-warning text-dark">未承認</span>
                  <% elsif scout.status == 'accepted' %>
                    <span class="badge bg-success">承認済み</span>
                  <% elsif scout.status == 'rejected' %>
                    <span class="badge bg-secondary">辞退された</span>
                  <% end %>
                </div>
              </div>

              <%# マッチングが成立している場合、スキルホルダーのSNS情報を表示 %>
              <% if scout.status == 'accepted' && Match.exists?(project: scout.project, matched_user_id: scout.scouted_user_id) %>
                <div class="alert alert-success mt-3 mb-0">
                  <h6 class="alert-heading">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    マッチング成立！スキルホルダーの連絡先
                  </h6>
                  <% scouted_user_sns_links = scout.scouted_user.sns_links.where(visible_after_match: true) %>
                  <% if scouted_user_sns_links.any? %>
                    <div class="list-group list-group-flush">
                      <% scouted_user_sns_links.each do |sns_link| %>
                        <a href="<%= sns_link.url %>" target="_blank" class="list-group-item list-group-item-action d-flex align-items-center py-2">
                          <% case sns_link.platform %>
                          <% when 'Twitter' %>
                            <i class="bi bi-twitter me-2 text-primary"></i>
                          <% when 'Instagram' %>
                            <i class="bi bi-instagram me-2" style="color: #E4405F;"></i>
                          <% when 'Facebook' %>
                            <i class="bi bi-facebook me-2 text-primary"></i>
                          <% when 'Discord' %>
                            <i class="bi bi-discord me-2" style="color: #5865F2;"></i>
                          <% when 'Slack' %>
                            <i class="bi bi-slack me-2" style="color: #4A154B;"></i>
                          <% when 'LINE' %>
                            <i class="bi bi-line me-2" style="color: #00B900;"></i>
                          <% when 'Email' %>
                            <i class="bi bi-envelope me-2"></i>
                          <% else %>
                            <i class="bi bi-link-45deg me-2"></i>
                          <% end %>
                          <span><strong><%= sns_link.platform %>:</strong> <%= sns_link.url %></span>
                          <i class="bi bi-box-arrow-up-right ms-auto"></i>
                        </a>
                      <% end %>
                    </div>
                  <% else %>
                    <p class="mb-0 small">スキルホルダーの連絡先が登録されていません。</p>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="alert alert-info">
          送信したスカウトはありません
        </div>
      <% end %>
    </div>
  </div>
</div>
