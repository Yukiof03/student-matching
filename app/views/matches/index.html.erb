<div class="container mt-4">
  <h1 class="mb-4">マッチング一覧</h1>

  <% if @matches.any? %>
    <div class="row">
      <% @matches.each do |match| %>
        <div class="col-md-6 mb-4">
          <div class="card h-100">
            <div class="card-body">
              <h5 class="card-title">
                <%= link_to match.project.title, project_path(match.project) %>
              </h5>

              <div class="mb-3">
                <span class="badge bg-success">マッチング成立</span>
                <small class="text-muted ms-2">
                  <%= match.matched_at.strftime('%Y/%m/%d %H:%M') %>
                </small>
              </div>

              <p class="card-text">
                <strong>マッチングした相手:</strong><br>
                <%= match.matched_user.name %>
              </p>

              <div class="d-grid">
                <%= link_to '詳細を見る', match_path(match), class: 'btn btn-primary' %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="alert alert-info">
      まだマッチングが成立していません
    </div>
  <% end %>
</div>
